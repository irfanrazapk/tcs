# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# OPTIONAL BACKEND INTEGRATIONS:
# Inquiries are validated and logged to server output by default.
# To persist inquiries to MongoDB or dispatch email notifications:
# MONGODB_URI="mongodb+srv://username:password@cluster.mongodb.net/trust_code_db"
# RESEND_API_KEY="re_123456789"
# NOTIFICATION_RECIPIENT_EMAIL="investors@trustcodesystem.com"
